# --------------------- Server Settings ----------------------
PORT=3002
HOST=127.0.0.1
NODE_ENV=development
SHUTDOWN_TIMEOUT_MS=10000
APP_NAME=BudgetPlanner
APP_ID=budgetplanner
# Public origin of this deployment; required when Clerk is enabled (authorizedParties).
APP_PUBLIC_BASE_URL=http://127.0.0.1:3002
# Sibling apps that share Clerk sessions via COOKIE_DOMAIN=.darkavianlabs.com.
ALLOWED_APP_ORIGINS=https://codex.darkavianlabs.com,https://armory.darkavianlabs.com,https://outfitter.darkavianlabs.com,https://budget.darkavianlabs.com

# ------------------- Session Settings -----------------------
SESSION_SECRET=budgetplanner-dev-secret-change-me
SESSION_COOKIE_NAME=budgetplanner.sid

# -------------------- Proxy Settings ------------------------
TRUST_PROXY=0
SECURE_COOKIES=0

# ------------------- Cookie Settings ------------------------
COOKIE_DOMAIN=

# ------------------- Databases ------------------------------
SESSION_DB_PATH=./data/sessions.db
APP_DB_PATH=./data/app.db

# ------------------- Clerk Settings -------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# CLERK_FAPI_URL=https://clerk.darkavianlabs.com

# ------------------- Vite Settings --------------------------
VITE_DEV_API_TARGET=http://127.0.0.1:3002
VITE_DEV_PORT=5173
VITE_BASE_PATH=/
VITE_APP_NAME=BudgetPlanner
VITE_LEGAL_ENTITY_NAME=Dark Avian Labs
VITE_LEGAL_PAGE_URL=https://darkavianlabs.com/legal/
# LEGAL_PAGE_URL=https://darkavianlabs.com/legal/
# VITE_SHARED_THEME_COOKIE_DOMAIN=

